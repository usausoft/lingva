  },
  "dependencies": {
    "@lingva/core": "workspace:*",
    "@lingva/vue": "workspace:*",
    "nuxt": "4.6.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@lingva/cli": "workspace:*",
    "@lingva/eslint-config": "workspace:*",
    "eslint": "^9.39.2",
    "rolldown": "1.2.1",
    "typescript": "^5.9.3"
  }
}
