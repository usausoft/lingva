{
  "name": "@lingva/example-nuxt-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3600",
    "build": "nuxt typecheck && nuxt build",
