# Lingva hosted delivery settings for the Next.js starter.
# Copy to `.env.local` or export these values in your shell before hosted push.

# Required for hosted project identity and dashboard matching.
LINGVA_PROJECT_ID=next-starter

# Hosted publish endpoint from the project's Consumer application setup.
LINGVA_PUBLISH_API_URL=https://example.lambda-url.aws/

# Public OAuth values from the copyable CLI login command on the same setup page.
LINGVA_AUTH_ISSUER_URL=https://auth.example.com/
LINGVA_AUTH_CLIENT_ID=lingva-cli

# Remote delivery — set all three to consume translation bundles from the hosted platform.
# 1. Create a project in the Lingva dashboard and copy its bundle URL.
# 2. Create an SDK key in the project settings (delivery:read scope).
# 3. Set LINGVA_DELIVERY_MODE=hosted to switch from local files to CDN bundles.
LINGVA_DELIVERY_MODE=local
LINGVA_BUNDLE_URL=
LINGVA_API_KEY=

# This delivery:read key is safe for runtime identification, but cannot publish.
# Never expose authoring, administration, or write credentials through NEXT_PUBLIC_* variables.
