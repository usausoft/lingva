# Optional HTTP bundle delivery settings for this consumer starter.
# Copy to .env.local and replace placeholders with your project values.
LINGVA_DELIVERY_MODE=hosted-local
LINGVA_BUNDLE_URL=https://example.invalid/bundles/next-starter/local/latest/{locale}.bundle.json
LINGVA_DELIVERY_AUTH_TOKEN=replace-with-read-scoped-key
LINGVA_PROJECT_ID=next-starter
LINGVA_PUBLISH_API_URL=https://example.invalid/publish
