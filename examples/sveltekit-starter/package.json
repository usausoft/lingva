{
  "name": "@lingva/example-sveltekit-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3700",
    "build": "vite build",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lingva:check": "lingva check",
    "verify:starter": "node scripts/verify-starter.mjs"
  },
  "dependencies": {
    "@lingva/core": "workspace:*",
    "@lingva/svelte": "workspace:*",
    "@sveltejs/kit": "3.0.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@lingva/cli": "workspace:*",
    "@lingva/eslint-config": "workspace:*",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "^9.39.2",
    "svelte-check": "^4.3.4",
    "typescript": "6.0.3",
    "vite": "^8.0.16"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
