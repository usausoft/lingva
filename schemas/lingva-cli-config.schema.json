{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingva.dev/schemas/lingva-cli-config.schema.json",
  "title": "Lingva portable CLI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "locales"],
  "properties": {
    "projectId": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1, "default": "dev" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "defaultLocale": { "type": "string", "minLength": 1 },
    "fallbackLocale": { "type": "string", "minLength": 1 },
    "translationFiles": {
      "type": "string",
      "minLength": 1,
      "default": ".lingva/translations/{locale}.json"
    },
    "apiUrl": { "type": "string", "minLength": 1 },
    "apiKeyEnv": { "type": "string", "minLength": 1, "default": "LINGVA_API_KEY" },
    "apiKey": { "type": "string", "minLength": 1 }
  }
}
