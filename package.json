{
  "name": "lingva",
  "version": "0.0.1",
  "description": "Language infrastructure for developers",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && pnpm lint:repo",
    "lint:repo": "eslint eslint.config.js scripts tsdown.shared.ts --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "audit:prod": "pnpm audit --prod",
    "build:cli": "cargo build --release --locked --package lingva",
    "build:packages": "node scripts/build-public-packages.mjs",
    "test:cli": "cargo test --workspace --locked",
    "test:cli-release": "node --test scripts/render-homebrew-formula.test.mjs scripts/update-homebrew-tap.test.mjs scripts/build-package.test.mjs scripts/verify-cli-recovery.test.mjs scripts/verify-public-boundary.test.mjs scripts/verify-cli-prepared-release.test.mjs scripts/release-auth.test.mjs",
    "verify:cli-adapters": "node scripts/verify-cli-engine-version.mjs",
    "dev:consumer": "pnpm --filter @lingva/example-next-starter dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify:packages": "node scripts/verify-public-packages.mjs",
    "release": "pnpm build:packages && pnpm verify:packages && changeset publish",
    "dev": "pnpm --filter @lingva/example-next-starter dev",
    "dev:docs": "pnpm --filter @lingva/docs dev",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs"
  },
  "keywords": [
    "i18n",
    "l10n",
    "internationalization",
    "localization"
  ],
  "author": "Yury Saukou <yury.saukou@gmail.com>",
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lingva/eslint-config": "workspace:*",
    "@lingva/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "0.35.5",
    "turbo": "^2.9.14",
    "typescript": "^5.3.0",
    "yaml": "^2.9.1",
    "@lingva/build-tools": "workspace:*"
  },
  "lingvaPlane": "consumer"
}
