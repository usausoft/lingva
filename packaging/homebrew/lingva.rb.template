class Lingva < Formula
  desc "Standalone CLI for the Lingva localization platform"
  homepage "https://lingva.dev"
  version "@VERSION@"
  license :cannot_represent

  on_macos do
    if Hardware::CPU.arm?
      url "https://unpkg.com/@lingva/cli@@VERSION@/assets/lingva-aarch64-apple-darwin.tar.gz"
      sha256 "@AARCH64_APPLE_DARWIN_SHA256@"
    else
      url "https://unpkg.com/@lingva/cli@@VERSION@/assets/lingva-x86_64-apple-darwin.tar.gz"
      sha256 "@X86_64_APPLE_DARWIN_SHA256@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://unpkg.com/@lingva/cli@@VERSION@/assets/lingva-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@AARCH64_UNKNOWN_LINUX_GNU_SHA256@"
    else
      url "https://unpkg.com/@lingva/cli@@VERSION@/assets/lingva-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@X86_64_UNKNOWN_LINUX_MUSL_SHA256@"
    end
  end

  def install
    bin.install "lingva"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/lingva --version")
  end
end
